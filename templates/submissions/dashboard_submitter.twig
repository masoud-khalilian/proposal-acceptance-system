{% extends 'layout/base.twig' %}
{% block content %}
    <h1>{{ t('submission.my_submissions') }}</h1>

    {% if submissions is empty %}
        <p>{{ t('submission.no_submissions') }}</p>
    {% else %}
        <div class="table-scroll">
        <table class="data-table">
            <thead>
            <tr>
                <th>{{ t('submission.title') }}</th>
                <th>{{ t('submission.workflow_type') }}</th>
                <th>{{ t('submission.created_at') }}</th>
                <th>{{ t('review.decision') }}</th>
                <th>{{ t('submission.attachment') }}</th>
            </tr>
            </thead>
            <tbody>
            {% for submission in submissions %}
                <tr>
                    <td>{{ submission.title }}</td>
                    <td>{{ locale == 'fa' ? submission.workflow_label_fa : submission.workflow_label_en }}</td>
                    <td>{{ submission.created_at }}</td>
                    <td>{{ submission.status == 'approved' ? t('submission.status_approved') : t('submission.status_pending') }}</td>
                    <td>
                        {% if submission.attachment_filename %}
                            <a class="attachment-link" href="/submissions/{{ submission.id }}/attachment">{{ t('submission.download_attachment') }}</a>
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
        </div>
    {% endif %}

    <h2>{{ t('submission.new_submission') }}</h2>
    <form action="/submitter/submissions" method="post" enctype="multipart/form-data" class="basic-grey">
        <input type="hidden" name="csrf_name" value="{{ csrf_name }}">
        <input type="hidden" name="csrf_value" value="{{ csrf_value }}">

        <div class="field">
            <label class="field-label" for="workflow_type">{{ t('submission.workflow_type') }}</label>
            <select id="workflow_type" name="workflow_type" required>
                {% for wt in workflow_types %}
                    <option value="{{ wt.key }}">{{ locale == 'fa' ? wt.label_fa : wt.label_en }}</option>
                {% endfor %}
            </select>
        </div>

        <div class="field">
            <label class="field-label" for="title">{{ t('submission.title') }}</label>
            <input id="title" type="text" name="title" required>
        </div>

        <div class="field">
            <label class="field-label" for="content">{{ t('submission.content') }}</label>
            <textarea id="content" name="content" class="mytextarea" required></textarea>
        </div>

        <div class="field">
            <label class="field-label" for="attachment">{{ t('submission.attachment') }}</label>
            <input id="attachment" type="file" name="attachment" accept="application/pdf">
            <span class="field-hint">{{ t('submission.attachment_hint') }}</span>
        </div>

        <fieldset>
            <legend>{{ t('submission.reviewers') }}</legend>
            {% for reviewer in reviewers %}
                <label class="checkbox-row">
                    <input type="checkbox" name="reviewer_ids[]" value="{{ reviewer.id }}">
                    {{ reviewer.first_name }} {{ reviewer.last_name }} ({{ reviewer.capacity }})
                </label>
            {% endfor %}
        </fieldset>

        <label><input type="submit" class="button" value="{{ t('submission.submit') }}"></label>
    </form>
{% endblock %}
