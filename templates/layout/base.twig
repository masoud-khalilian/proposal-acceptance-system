<!doctype html>
<html lang="{{ locale }}" dir="{{ direction }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ t('app.name') }}</title>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Crect width='24' height='24' rx='6' fill='%232f6feb'/%3E%3Cpath d='M6 12.5l4 4 8-9' fill='none' stroke='white' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E">
    <link rel="stylesheet" href="/assets/css/app.css">
</head>
<body>
<header class="topbar">
    <a class="brand" href="/">
        <span class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="28" height="28"><rect width="24" height="24" rx="6" fill="currentColor"/><path d="M6 12.5l4 4 8-9" fill="none" stroke="white" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
        <span>{{ t('app.name') }}</span>
    </a>
    <nav>
        {% if current_actor.id %}
            <a href="/dashboard">{{ t('nav.dashboard') }}</a>
            <form action="/logout" method="post" class="inline-form">
                <input type="hidden" name="csrf_name" value="{{ csrf_name }}">
        <input type="hidden" name="csrf_value" value="{{ csrf_value }}">
                <button type="submit" class="link-button">{{ t('nav.logout') }}</button>
            </form>
        {% else %}
            <a href="/login">{{ t('nav.login') }}</a>
            <a href="/register">{{ t('nav.register') }}</a>
        {% endif %}
        <span class="lang-switch">
            <a href="?lang=fa" class="{{ locale == 'fa' ? 'active' : '' }}">فا</a>
            <a href="?lang=en" class="{{ locale == 'en' ? 'active' : '' }}">EN</a>
        </span>
    </nav>
</header>

<main class="content">
    {% if flash %}
        <div class="flash flash-{{ flash.type }}">{{ flash.message }}</div>
    {% endif %}
    {% block content %}{% endblock %}
</main>
<footer class="app-footer">v{{ app_version }}</footer>
</body>
</html>
