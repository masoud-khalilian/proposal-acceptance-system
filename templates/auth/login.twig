{% extends 'layout/base.twig' %}
{% block content %}
    <form action="/login" method="post" class="basic-grey">
        <h1>{{ t('auth.login_title') }}<span>{{ t('auth.login_subtitle') }}</span></h1>
        <input type="hidden" name="csrf_name" value="{{ csrf_name }}">
        <input type="hidden" name="csrf_value" value="{{ csrf_value }}">

        <div class="field">
            <label class="field-label" for="username">{{ t('auth.username') }}</label>
            <input id="username" type="text" name="username" autocomplete="username" required>
        </div>
        <div class="field">
            <label class="field-label" for="password">{{ t('auth.password') }}</label>
            <input id="password" type="password" name="password" autocomplete="current-password" required>
        </div>

        <div class="field">
            <span class="field-label">{{ t('auth.role') }}</span>
            <div class="radio_label">
                <label><input type="radio" name="role" value="submitter" checked> {{ t('auth.role_submitter') }}</label>
                <label><input type="radio" name="role" value="reviewer"> {{ t('auth.role_reviewer') }}</label>
                <label><input type="radio" name="role" value="admin"> {{ t('auth.role_admin') }}</label>
            </div>
        </div>

        <label><input type="submit" class="button" value="{{ t('auth.submit_login') }}"></label>
    </form>
    <p><a href="/register">{{ t('auth.no_account') }}</a></p>
{% endblock %}
